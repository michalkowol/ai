#!/bin/bash

set -e

TOOL="claude"
DIR=""
IMAGE_KIND="java"
IMAGE_VERSION="21"
MODEL=""
RESUME=""
UPDATE=""
DASHBOARD="1"
DASHBOARD_PORT="${AI_DASHBOARD_PORT:-8787}"

USAGE="Usage: ai [--claude|--cursor|--bash] [--java <version>|--node <version>] [--model <model>] [--resume <session-id>] [--update] [--without-dashboard] [path]"

while [ $# -gt 0 ]; do
    case "$1" in
        --claude)
            TOOL="claude"
            shift
            ;;
        --cursor)
            TOOL="cursor"
            shift
            ;;
        --bash)
            TOOL="bash"
            shift
            ;;
        --java)
            if [ -z "$2" ]; then
                echo "Error: --java requires a version argument" >&2
                exit 1
            fi
            IMAGE_KIND="java"
            IMAGE_VERSION="$2"
            shift 2
            ;;
        --java=*)
            IMAGE_KIND="java"
            IMAGE_VERSION="${1#--java=}"
            shift
            ;;
        --node)
            if [ -z "$2" ]; then
                echo "Error: --node requires a version argument" >&2
                exit 1
            fi
            IMAGE_KIND="node"
            IMAGE_VERSION="$2"
            shift 2
            ;;
        --node=*)
            IMAGE_KIND="node"
            IMAGE_VERSION="${1#--node=}"
            shift
            ;;
        --model)
            if [ -z "$2" ]; then
                echo "Error: --model requires a model argument" >&2
                exit 1
            fi
            MODEL="$2"
            shift 2
            ;;
        --model=*)
            MODEL="${1#--model=}"
            shift
            ;;
        --resume)
            if [ -z "$2" ]; then
                echo "Error: --resume requires a session id argument" >&2
                exit 1
            fi
            RESUME="$2"
            shift 2
            ;;
        --resume=*)
            RESUME="${1#--resume=}"
            shift
            ;;
        --update)
            UPDATE="1"
            shift
            ;;
        --without-dashboard)
            DASHBOARD=""
            shift
            ;;
        --*)
            echo "Unknown option: $1" >&2
            echo "$USAGE" >&2
            exit 1
            ;;
        *)
            if [ -n "$DIR" ]; then
                echo "Unexpected argument: $1" >&2
                echo "$USAGE" >&2
                exit 1
            fi
            DIR="$1"
            shift
            ;;
    esac
done

DIR="${DIR:-.}"
WORKTREE_DIR="$(realpath "$DIR")"

if [ ! -d "$WORKTREE_DIR" ]; then
    echo "Error: Directory '$WORKTREE_DIR' does not exist!" >&2
    exit 1
fi

GIT_ENV=()
HOST_GIT_NAME="${GIT_AUTHOR_NAME:-$(git -C "$WORKTREE_DIR" config user.name 2>/dev/null || true)}"
HOST_GIT_EMAIL="${GIT_AUTHOR_EMAIL:-$(git -C "$WORKTREE_DIR" config user.email 2>/dev/null || true)}"
HOST_COMMIT_EMAIL="${GIT_COMMITTER_EMAIL:-$HOST_GIT_EMAIL}"
if [ -n "$HOST_GIT_NAME" ]; then
    GIT_ENV+=(-e "GIT_AUTHOR_NAME=$HOST_GIT_NAME")
fi
if [ -n "$HOST_GIT_EMAIL" ]; then
    GIT_ENV+=(-e "GIT_AUTHOR_EMAIL=$HOST_GIT_EMAIL")
fi
if [ -n "$HOST_COMMIT_EMAIL" ]; then
    GIT_ENV+=(-e "GIT_COMMITTER_EMAIL=$HOST_COMMIT_EMAIL")
fi

SETTINGS_ENV=()
if [ -f "$HOME/.ai/settings.env" ]; then
    SETTINGS_ENV+=(--env-file "$HOME/.ai/settings.env")
fi

EXTRA_MOUNTS=()
if [ -f "$WORKTREE_DIR/.git" ]; then
    GIT_COMMON_DIR="$(cd "$WORKTREE_DIR" && git rev-parse --git-common-dir 2>/dev/null || true)"
    if [ -n "$GIT_COMMON_DIR" ]; then
        case "$GIT_COMMON_DIR" in
            /*) ;;
            *) GIT_COMMON_DIR="$WORKTREE_DIR/$GIT_COMMON_DIR" ;;
        esac
        GIT_COMMON_DIR="$(realpath "$GIT_COMMON_DIR")"
        EXTRA_MOUNTS+=(-v "$GIT_COMMON_DIR:$GIT_COMMON_DIR")
    fi
fi

AI_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
cd "$AI_DIR"

case "$IMAGE_KIND" in
    java) BASE_IMAGE="eclipse-temurin:${IMAGE_VERSION}" ;;
    node) BASE_IMAGE="node:${IMAGE_VERSION}" ;;
esac

IMAGE_TAG="ai:${IMAGE_KIND}${IMAGE_VERSION}"

if [ -n "$UPDATE" ]; then
    docker build -t "$IMAGE_TAG" --build-arg "BASE_IMAGE=${BASE_IMAGE}" --pull --no-cache .
else
    docker build -q -t "$IMAGE_TAG" --build-arg "BASE_IMAGE=${BASE_IMAGE}" . > /dev/null
fi

RUNS_DIR="$AI_DIR/claude/.claude/ai-runs"
mkdir -p "$RUNS_DIR"

prune_runs() {
    local live run_dir run_id
    live="$(docker ps --filter label=ai.run --format '{{.Label "ai.run"}}' 2>/dev/null || true)"
    for run_dir in "$RUNS_DIR"/*/; do
        [ -d "$run_dir" ] || continue
        run_id="$(basename "$run_dir")"
        if printf '%s\n' "$live" | grep -qx "$run_id"; then
            continue
        fi
        if [ -n "$(find "$run_dir" -maxdepth 0 -mmin +2)" ]; then
            rm -rf "$run_dir"
        fi
    done
}

# A running container keeps serving from the directory it was started with, even after that
# directory is replaced (branch switch) or removed (worktree removal), so check it still works.
dashboard_is_current() {
    local mounted
    mounted="$(docker inspect ai-dashboard \
        --format '{{range .Mounts}}{{if eq .Destination "/dashboard"}}{{.Source}}{{end}}{{end}}' 2>/dev/null || true)"
    [ "$mounted" = "$AI_DIR/dashboard" ] || return 1
    curl -fs -o /dev/null --max-time 2 "http://127.0.0.1:${DASHBOARD_PORT}/"
}

ensure_dashboard() {
    if [ -z "$(docker ps -q --filter "name=^ai-dashboard$")" ] || ! dashboard_is_current; then
        docker rm -f ai-dashboard >/dev/null 2>&1 || true
        docker run -d --init --name ai-dashboard \
            -p "127.0.0.1:${DASHBOARD_PORT}:8787" \
            -v "$AI_DIR/claude/.claude:/home/ubuntu/.claude:ro" \
            -v "$AI_DIR/dashboard:/dashboard:ro" \
            "$IMAGE_TAG" python3 /dashboard/server.py --host 0.0.0.0 --port 8787 >/dev/null \
            || { echo "Warning: dashboard failed to start" >&2; return; }
    fi
    echo "Dashboard: http://localhost:${DASHBOARD_PORT}"
}

prune_runs
if [ -n "$DASHBOARD" ]; then
    ensure_dashboard
fi

CLAUDE_MOUNTS=(
    -v "$AI_DIR/claude/.claude:/home/ubuntu/.claude"
    -v "$AI_DIR/claude/.claude.json:/home/ubuntu/.claude.json"
    -v "$AI_DIR/config/claude/managed-settings.json:/etc/claude-code/managed-settings.json:ro"
)

CURSOR_MOUNTS=(
    -v "$AI_DIR/cursor/.cursor:/home/ubuntu/.cursor"
    -v "$AI_DIR/cursor/.config/cursor:/home/ubuntu/.config/cursor"
)

if [ "$TOOL" = "claude" ]; then
    MODEL="${MODEL:-opus}"
fi

case "$TOOL" in
    claude) CMD=("claude" "--dangerously-skip-permissions" "--effort" "max") ;;
    cursor) CMD=("cursor-agent" "--force") ;;
    bash)   CMD=("bash") ;;
esac

if [ -n "$MODEL" ]; then
    case "$TOOL" in
        claude|cursor) CMD+=("--model" "$MODEL") ;;
        *)
            echo "Error: --model is only supported with --claude or --cursor" >&2
            exit 1
            ;;
    esac
fi

if [ -n "$RESUME" ]; then
    case "$TOOL" in
        claude|cursor) CMD+=("--resume" "$RESUME") ;;
        *)
            echo "Error: --resume is only supported with --claude or --cursor" >&2
            exit 1
            ;;
    esac
fi

DOCKER_SOCK_GID=$(docker run --rm -v /var/run/docker.sock:/var/run/docker.sock "$IMAGE_TAG" stat -c '%g' /var/run/docker.sock)

RUN_ID="$(date +%Y%m%d-%H%M%S)-$$"
RUN_DIR="$RUNS_DIR/$RUN_ID"
mkdir -p -m 700 "$RUN_DIR/sessions"
printf 'worktree=%s\ntool=%s\nmodel=%s\nresume=%s\nstartedAt=%s\n' \
    "$WORKTREE_DIR" "$TOOL" "$MODEL" "$RESUME" "$(date +%s)" > "$RUN_DIR/run.env"

# The container outlives this script when the terminal is closed, so only remove the run dir once it is gone.
cleanup() {
    if [ -z "$(docker ps -q --filter "label=ai.run=$RUN_ID" 2>/dev/null)" ]; then
        rm -rf "$RUN_DIR"
    fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 143' TERM

docker run -it --rm \
    --label "ai.run=$RUN_ID" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    --group-add "$DOCKER_SOCK_GID" \
    --add-host=host.docker.internal:host-gateway \
    -v "$HOME/.gradle:/home/ubuntu/.gradle-ro:ro" \
    -e GRADLE_RO_DEP_CACHE=/home/ubuntu/.gradle-ro/caches \
    -v "$HOME/.m2:/home/ubuntu/.m2" \
    "${GIT_ENV[@]}" \
    "${SETTINGS_ENV[@]}" \
    -v "$WORKTREE_DIR:/workspace" \
    "${CLAUDE_MOUNTS[@]}" \
    -v "$RUN_DIR/sessions:/home/ubuntu/.claude/sessions" \
    "${CURSOR_MOUNTS[@]}" \
    "${EXTRA_MOUNTS[@]}" \
    "$IMAGE_TAG" "${CMD[@]}"
